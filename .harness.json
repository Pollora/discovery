{
    "profile": "core",
    "mode": "enforce",
    "downstream": [
        "framework"
    ],
    "allow_laravel": [
        "illuminate/collections"
    ],
    "ratchet": {
        "phpstan_level": 5,
        "phpstan_baseline": 0
    },
    "observed": [
        "Code style",
        "Rector",
        "Dependency analysis",
        "Security patterns"
    ]
}
